iscount:"Remise promotionnelle",promotions:{custom_colors:{description:"Ajoutez facilement de nouvelles couleurs à votre carte et enregistrez-les pour pouvoir les réutiliser. Vous pouvez adapter vos cartes à différents publics et cas d'utilisation.",header:"Personnalisez votre carte"},our_year_campaign:{description:"Dites au monde entier ce qui rend votre équipe formidable. Participez à notre concours #ThisIsOurYear pour vous démarquer en 2023 – et pour avoir une chance de gagner et de remporter des licences professionnelles MindMeister GRATUITES. Les étapes sont les suivantes :",headline:"#ThisIsOurYear. Gagnez des licences gratuites !",instruction_1:"Ouvrez le modèle <ml-shortcut>#ThisIsOurYear</ml-shortcut>.",instruction_2:"Remplissez le modèle de carte mentale avec votre équipe.",instruction_3:"Puis publiez le modèle sur la cartothèque publique pour participer !"},product_switcher:{description:"Passez rapidement d'un outil Meister à l'autre.",header:"Tout est lié"},team_maps:{description:"Un espace pour travailler ensemble sur des idées. Les cartes ici sont ouvertes à votre équipe.",header:"Présentation des cartes d'équipe"}},properties:"Propriétés",public:"Publiques",public_category_business:"Objectifs d'affaires",public_category_design:"Design",public_category_education:"Éducation et remarques",public_category_entertainment:"Loisirs",public_category_events:"Evénements",public_category_human_resources:"Ressources humaines",public_category_layout:"Mise en page",public_category_life:"Vie courante",public_category_marketing:"Marketing et contenu",public_category_other:"Autre",public_category_productivity:"Brainstorming et analyse",public_category_project_management:"Gestion de projet",public_category_reference:"Référence",public_category_summaries:"Résumés",public_category_technology:"Technologie",public_category_travel:"Voyage",public_link:"Lien public",public_maps:"Cartes publiques",public_try_again:"Réessayez avec moins de restrictions",publicmaps:"Cartes popul
en konto med adgang.",mm_feature:{admin_account:{description:"Hav styr på alle licenser med én administratorkonto og centraliseret fakturering.",name:"Opgrader nu til administratorkonto",title:"administratorkonto"},api_hide_map_ui:{name:"Opgrader nu for tilpassede indlejrede kort",title:"tilpassede indlejrede maps"},bonus_cash:{name:"Opgrader nu for affiliate bonus kontanter",title:"kontant affiliate-bonus"},branding:{name:"Opgrader nu for tilpasset produktbranding",title:"brugerdefineret produktbranding"},bulk_export:{name:"Opgrader nu for fuld eksport af personlige mindmap-biblioteker",title:"eksporter alle dine mind maps på én gang"},bulk_export_and_backup:{description:"Eksportér en masse og lav backup af dit teams data til dine egne servere via SSH eller FTPS.",name:"Opgrader nu for eksport og sikkerhedskopiering af overholdelse af regler",title:"sikker eksport og backup af mindmaps"},bulk_share:{description:"Inviter flere samarbejdspartnere på én gang.",name:"Opgrader nu for massedeling",title:"massedeling"},community_support:{name:"Opgrader nu for fællesskabssupport",title:"support fra brugerforum"},custom_colors:{description_v2:"Skab smukke, engagerende og brandede mindmaps på ingen tid – hver eneste gang. Du skal blot tilføje og gemme brugerdefinerede nuancer til din palet, og kortlægge dine ideer med stil.",nagger_v2:"Indstil dine egne brugerdefinerede farver",title:"Brugerdefinerede farver"},ebooks:{name:"Opgrader nu for at få e-bøger",title:"e-bøger"},embed_hide_bar:{name:"Opgrader nu for tilpassede indlejrede kort",title:"tilpassede indlejrede maps"},embed_hide_logo:{name:"Opgrader nu for indlejrede kort uden mærke",title:"umærkede indlejrede maps"},embed_hide_share:{name:"Opgrader nu for tilpassede indlejrede kort",title:"tilpassede indlejrede maps"},embed_live_update:{description:"Indlejr mindmaps på blogge eller andre hjemmesider med mulighed for at opdatere indholdet på mindmappet i realtid.",name:"Opgrader nu for live opdatering i indlejrede kort",title:"live opdateringer i indlejrede maps"},export_docx:{description:"Konverter dine mindmaps til et Microsoft Word-dokument med mange muligheder for at oprette indholdsfortegnelser, overskriftstypografier, m.m.",description_v2:"Se og rediger dit kort fra et nyt perspektiv – i et klassisk format. Med blot et par klik kan du konvertere dit mindmap til et Microsoft Word-dokument med en indholdsfortegnelse, strukturerede overskrifter og meget mere.",nagger_v2:"Eksporter dine kort til Microsoft Word",name:"Opgrader nu for Word-eksport",title:"Word-eksport"},export_image:{description_v2:"Vis dine mindmaps som billeder med PNG- eller JPG-eksport. Upload nemt dine kort til præsentationer, vedhæft til e-mails eller integrer i dokumenter for stressfri deling. ",nagger_v2:"Eksporter dine kort som billeder",name:"Opgrader nu for billedeksport",title:"billedeksport"},export_mind:{name:"Opgrader nu for MindMeister-eksport",title:"MindMeister-eksport"},export_mm:{description_v2:"Vi ved, at din passion for mindmapping kan få dig til at prøve forskellige værktøjer. Det er derfor, vi har gjort det nemt for dig at eksportere dine kort til filer, der er kompatible med Freemind.",nagger_v2:"Eksporter dine kort til Freemind",name:"Opgrader nu for Freemind-eksport",title:"Freemind-eksport"},export_mmap:{description_v2:"Vi ved, at din passion for mindmapping kan få dig til at prøve forskellige værktøjer. Det er derfor, vi har gjort det nemt for dig at eksportere dine kort til filer, der er kompatible med Mind Manager.",nagger_v2:"Eksporter dine kort til Mind Manager",name:"Opgrader nu for MindManager-eksport",title:"MindManager-eksport"},export_pdf:{description:"Eksporter dine mindmaps som flotte PDF-dokumenter, der kan indekseres og deles via e-mail eller gemmes som en sikkerhedskopi",description_v2:"Samme kort, andet format – og ikke mindre smukt. Eksporter dit mindmap som en PDF for stressfri deling.",nagger_v2:"Eksporter dine kort til PDF",title:"PDF-eksport"},export_pptx:{description:"Konverter dine mindmaps til en Microsoft PowerPoint-præsentation med mange muligheder for konturer, inline-grafik m.m.",description_v2:"Præsenter dine kort på en traditionel måde: i Microsoft PowerPoint. Med blot et par klik kan du konvertere dit mindmap til en PowerPoint-præsentation med konturer, billeder og mere.",nagger_v2:"Eksporter dine kort til PowerPoint",name:"Opgrader nu for PowerPoint-eksport",title:"PowerPoint-eksport"},export_presentation_pdf:{description:"Hvis dit mindmaps har diasbilleder, kan du eksportere præsentationen som PDF.",description_v2:"Samme præsentation, anderledes format – og ikke mindre smuk. Eksporter dine præsentationer som en PDF for stressfri deling.\n",nagger_v2:"Eksporter dine præsentationer til PDF ",name:"Opgrader nu for at eksportere præsentation som PDF",title:"eksporter præsentationen som PDF"},export_presentation_zip:{description:"Hvis dit mindmap har diasbilleder, kan du eksportere præsentationen som et ZIP-arkiv",description_v2:"Samme præsentation, anderledes format – og ikke mindre smuk. Eksporter dine præsentationer som en ZIP for stressfri deling.",nagger_v2:"Eksporter dine præsentationer til ZIP",name:"Opgrader nu for at eksportere præsentationer som zip",title:"eksporter præsentation som zip"},export_rtf:{name:"Opgrader nu for eksport af Rich Text Format",title:"Eksport af Rig Tekst Format"},export_xmind:{description_v2:"Vi ved, at din passion for mindmapping kan få dig til at prøve forskellige værktøjer. Det er derfor, vi har gjort det nemt for dig at eksportere dine kort til filer, der er kompatible med Xmind.",nagger_v2:"Eksporter dine kort til Xmind",name:"Opgrader nu forXMind-eksport",title:"XMind-eksport"},g_suite_sign_on:{description:"Forvandl dit Google Workspace team til et MindMeister team.",name:"Opgrader nu for Google Workspace til logon på domæner",title:"Google Workspace til tilmelding af domæner"},history:{name:"Opgrader nu for at få historik over mindmap-revisioner",title:"revisionshistorik af mind maps"},import_image:{name:"Opgrader nu for billedimport af sticky notes",title:"import af klisterseddelbilleder"},limited_maps:{name:"Opgrader nu for op til 3 mindmaps",title:"op til 3 mind maps"},map_attachments:{nagger_v2:"Få 2 vedhæftede filer pr. kort og mere",name:"Opgrader nu for at få adgang til vedhæftede filer og billeder",title:"fil & billedvedhæftninger"},map_attachments_limited:{flash_message:"Opgrader plan for ubegrænsede vedhæftede filer.",flash_message_media:"Opgrader plan for ubegrænset medieindlejring.",nagger:"Få 2 vedhæftede filer pr. kort og mere",nagger_v2:"Få 2 vedhæftede filer pr. kort og mere",paywall_header:"Lås op for vedhæftede filer, og tilføj detaljer til dit kort",paywall_media_header:"Lås medie- og billedindlejringer op på dit kort",title:"2 vedhæftede filer pr. kort"},map_attachments_unlimited:{description_v2:"Berig dine mindmaps med ubegrænsede fil- og billedvedhæftninger. Føj dem direkte til individuelle kortemner for at kontekstualisere dine ideer og bringe dine kort ud i livet.",flash_message:"Du har nået grænsen for dine vedhæftede filer. Opgrader plan for ubegrænsede vedhæftede filer.",flash_message_media:"Du har nået din medieindlejringsgrænse. Opgrader plan for ubegrænsede indlejringer.",nagger:"Få ubegrænsede vedhæftede filer og meget mere",nagger_v2:"Få ubegrænsede vedhæftede filer",paywall_content:"Forbedre dine projekter ved at tilføje filer og billeder på tværs af kortet.",paywall_header:"Lås op for ubegrænsede vedhæftede filer",paywall_media_content:"Forbedre visuelt dit kort ved at integrere billeder.",paywall_media_header:"Lås op for ubegrænsede medieuploads",title:"Ubegrænset antal vedhæftede filer"},map_custom_styles:{description:"Formater dine emnefarver, rammer, skrifttyper og fremstil tilpassede stilarter og gem dem til dit team.",name:"Opgrader nu for at få brugerdefinerede stilarter og afgrænsninger",title:"tilpassede stile og grænser"},map_custom_themes:{description:"Vælg blandt vores mange flotte eksisterende temaer eller opret dit eget for at give dit mindmap det rette udtryk. Tilpassede temaer kan også gemmes til dit team.",name:"Opgrader nu for at få brugerdefinerede temaer til dine kort",title:"tilpassede temaer til dine maps"},map_google_cse:{name:"Opgrader nu for ubegrænset søgning gennem Google",title:"ubegrænset Google søgning"},map_history_revert:{description:"Gå tilbage til en tidligere revision og se alle forandringer ved at bruge Historikvisning.",nagger_v2:"Få 7 dages versionshistorik og meget mere",name:"Opgrader nu for korthistorik og tilbageførsel",title:"mindmap-historik og -gendannelse"},map_history_revert_limited:{description:"Se tidligere versioner af Mind Maps i op til 7 dage, og kopier eller gendan dem, når du har brug for det.",nagger:"Få 7 dages versionshistorik og meget mere",nagger_v2:"Få 7 dages versionshistorik og meget mere",title:"7 dages versionshistorik"},map_history_revert_unlimited:{description:"Se et ubegrænset antal tidligere versioner af Mind Maps, og kopier eller gendan dem, når du har brug for det.",description_v2:"Når ideer flyder hurtigt, kan det være svært at holde styr på, hvem der tilføjede hvad, hvornår. Indtast: Ubegrænset versionshistorik. Se alle ændringer, der er foretaget på dit kort, og vend tilbage til eller dupliker en tidligere version.",nagger:"Få versionshistorik og meget mere",nagger_v2:"Få ubegrænset versionshistorik",title:"Ubegrænset versionshistorik"},map_print:{description:"Print dit mindmap på flere sider med mulighed for at tilpasse størrelse og billedformat, som du ønsker.",description_v2:"Har du brug for en papirkopi? Udskriv dit kort med få klik. Du kan endda tilpasse størrelsen og billedformatet, så det altid ser ud præcis, som du havde tænkt dig. ",nagger_v2:"Udskriv dine kort",name:"Opgrader nu for udskrivning af mindmaps",title:"print af mindmap"},map_templates:{name:"Opgrader nu for mindmap-skabeloner",title:"mindmap-skabeloner"},priority_support:{description:"Har du et problem? Få prioriteret svar fra vores support team.",name:"Opgrader nu for at få prioriteret support",title:"prioriteret support"},priority_support_24_7:{description:"Få garanteret hjælp indenfor 8 timer.",name:"Opgrader nu for at få 24x7 prioriteret support",title:"24x7 prioriteret support"},real_time_collaboration:{name:"Opgrader nu for at få samarbejde i realtid",title:"samarbejde i realtid"},task_feed:{name:"Opgrader nu for at tilføje dine opgaver til din kalender-app",title:"tilføj dine opgaver til din kalender app"},team_backup:{name:"Opgrader nu for sikker sikkerhedskopiering",title:"gem sikkerhedskopier"},team_domain:{description:"Indstil dit nye personlige logondomæne. <i>Eksempel: yourcompany.mindmeister.com</i>",name:"Opgrader nu for at få brugerdefineret teamdomæne",title:"tilpas team-domæne"},team_groups:{description:"Opsæt grupper med brugere og del nemt dine mind maps med alle gruppemedlemmer.",name:"Opgrader nu for at få grupper inden for dit team",title:"grupper i dit team"},team_ip_filter:{name:"Opgrader nu for at få IP-filter til dit team",title:"IP-filter til dit team"},team_members:{description:"Inviter flere brugere til dit team og administrer dit team.",name:"Opgrader nu for flere teammedlemmer",title:"flere team-medlemmer"},team_multiple_admins:{description:"Opsæt flere administratorer for dit hold, som kan styre brugerroller, ændre licenser og faktureringsoplysninger.",name:"Opgrader nu for flere teamadministratorer",title:"flere teamadministratorer"},team_signup_page:{description:"Din egen team-mærket tilmeldelsesside hvor nye brugere kan tilmelde sig og automatisk slutte sig til dit team.",name:"Opgrader nu for at få teamtilmeldingsside",title:"team tilmeldingsside"},team_statistics:{description:"Administratorer har adgang til rapporteringsfunktioner. Dette giver et overblik over holdets aktivitet, samt hvem der er logget ind, de mest aktive brugere og antal mindmaps pr. bruger.",name:"Opgrader nu for at få teamstatistik og rapporter",title:"team statistikker og rapporter"},trashcan:{description:"Gendan dine mind maps fra papirkurven",description_v2:"Blev revet med, mens du ryddede op? Tag det roligt, ved at vide, at vigtig information aldrig går tabt for altid. Gendan dine slettede mindmaps til enhver tid fra skraldespanden.",nagger_v2:"Gendan slettede mindmaps",name:"Opgrader nu for at få skraldespand / fortryd sletning",title:"papirkurv / fjern fra"},unlimited_maps:{description_v2:"Giv dine bedste ideer den plads, de fortjener. Opgrader til ubegrænsede kort – en perfekt pasform til dit teams grænseløse kreativitet.",flash_message:"Du har nået grænsen på 3 kort. Opgrader nu for ubegrænset mindmaps",nagger_v2:"Få ubegrænsede mindmaps",name:"Opgrader nu for ubegrænset antal mindmaps",title:"ubegrænsede mind maps"},unlimited_maps_experiment:{name:"Opgrader nu for ubegrænset antal redigerbare kort",title:"ubegrænset antal redigerbare kort"}},mm_mt_bundle_description:"Klar til at gøre dine idéer og planer til opgaver og projekter? Se MeisterTask, vores prisvindende værktøj til opgavestyring og samarbejde.",mm_task_hint:"Denne opgave er kun vist og kan ikke redigeres i den aktuelle version.",mn_invite_dialog_description:"",mn_invite_dialog_heading:"",mobile_app_teaser_heading:"Ønsker du at oprette og redigere mind maps?",mobile_app_teaser_text:"Se vores indbyggede mobile app.",mode_switcher:"Omskifter af tilstande",modified:"Modificeret",modified_by_s_s:"Ændret af %{v0} d. %{v1}",monday:"Mandag",monday_short:"man",monospace:"Monospace",month:"måned",monthly_payment:"Månedlig betaling",months_free:"%{count} måneder gratis",more:"Mere",more_child_ideas_d:"%{v0} underpunkter",more_collaborators:{one:"1 samarbejdspartner",other:"%{count} samarbejdspartnere"},more_colors:"Flere farver",more_d:"%{v0} mere",more_items_d:"%{v0} flere genstande",more_options:"Flere muligheder",more_preferences:"Flere Præferencer",move:"Flyt",move_and_rearrange:"Flyt og Omarranger",move_between_spaces_error:'Vi kunne ikke flytte " %{mapTitle} ". Prøv igen om et minut',move_map_to_my_maps:{content:'Alle i " %{teamName} " vil miste adgangen til " %{mapTitle} ".',heading:"Flytte til Mine kort?",not_allowed:{content:"Kun kortejere kan flytte deres kort",heading:"Kan ikke flytte til Mine kort"}},move_map_to_team:{content:'Alle i " %{teamName} " får adgang til " {{mapTitle}} ".',heading:"Flytte til Team maps?",not_allowed:{content:"Kun kortejere kan flytte deres kort",heading:"Kan ikke flytte til Team maps"}},move_task:"Flyt Opgave",move_task_admin_info:"Projektadministratorer kan invitere brugere til %{project} fra denne opgave i MindMeister.",move_task_assignee_access_warning:"Når du flytter denne opgave, vil alle, der ikke er inviteret til %{project}, ikke kunne få adgang til den. Dette gælder også %{name}, den nuværende opgaveansvarlige.",move_task_collaborators_warning:"Når du flytter denne opgave, vil alle, der ikke er inviteret til %{project}, ikke kunne få adgang til den.",move_to:"Flyt til",move_to_folder:"Flyt til Mappe",move_to_my_maps:"Flyt til Mine kort",move_to_team_maps:"Flyt til Team maps",move_to_trash:"Flytte til skrald",moved_to_my_maps:'" %{mapTitle} " blev flyttet til Mine kort',moved_to_team_maps:'" %{mapTitle} " blev flyttet til Team maps',ms_teams_tab:{creating_new_team_please_wait:"Oprettelse af et nyt hold på Microsoft Teams. Dette kan tage et par minutter, så vent venligst. Du får besked, når det er klart.",creating_team:"Opretter hold ...",creating_team_please_wait:"Opretter hold, vent venligst",disconnect_confirmation:"Vil du frakoble dette mindmap fra Microsoft Teams?",error_occurred_disconnect_unsuccessful:"Der opstod en fejl. Afbrydelse mislykkedes. Prøv igen.",error_occurred_during_team_creation_try_again:"Der opstod en fejl under initialisering af holdet i Microsoft Teams. Prøv igen.",mind_map_successfully_disconnected:"Mindmappet blev koblet fra Microsoft Team.",open_in_microsoft_teams:"Åben i Microsoft Teams",open_in_teams:"Åben i Teams",team_successfully_created_open_map_in_teams:"Dit hold er blevet oprettet. %{link_start}Åbn mindmap%{link_end} i Microsoft Teams",try_in_microsoft_teams:"Prøv MindMeister i Microsoft Teams",try_in_teams:"Prøv i Teams"},mt_activate_description:"Der er nogen, der venter på dig... du er blevet inviteret til at samarbejde i MeisterTask! Aktivér din konto, så du kan omdanne idéer til opgaver på intuitive Kanban-tavler.",mt_activate_meister_task_description:"Hvad med at omdanne disse idéer til opgaver, der kan gennemføres? Opret forbindelse til <ml-link>MeisterTask</ml-link>, vores værktøj til opgavestyring, der hjælper dig med at følge op på store idéer via intuitive Kanban-tavler.",mt_activate_title:"Aktiver din konto",mt_basic_user_project_hint:"Med dit basisabonnement kan du have 3 MeisterTask-projekter.",mt_collaborator_invite_info:"Når du har inviteret folk til MindMeister, kan du tilføje dem som projektmedlemmer.",mt_connect_description:"Er du klar til at omsætte dine idéer og planer til opgaver og projekter? Tjek <ml-link>MeisterTask</ml-link>, vores prisbelønnede <ml-bold>værktøj til opgavestyring og samarbejde</ml-bold>, ud.",mt_invite_tooltip:"Inviter kortsamarbejdspartnere til dit MeisterTask-projekt, og begynd at tildele opgaver.",mt_no_project_hint:"Du kan finde alle dine projekter her, når du har fået nogle. ",mt_no_section_hint:"Du kan finde alle dine sektioner her, når du har nogle. ",mt_pending_tooltip:"Denne person har endnu ikke accepteret din invitation.",mt_promotional_popover:{description:"Med vores forbedrede opgaveintegration kan du se opgavens forfaldsdato og modtagere direkte i dit kort.",title:"Opgaver flyttet til sidebjælken!"},mt_topics_into_tasks_promotion:"Omdan Mind Map-emner til opgaver på enhver projekttavle i MeisterTask.",mt_upgrade_teaser:"Få detaljerede statistikker og rapporter for alle dine projekter. Automatiser dine arbejdsgange. Projektgrupper. Ubegrænsede integrationer.",mt_warning_task_on_same_node:"Der kan kun knyttes én opgave pr. emne - og dette emne har allerede en opgave. Genindlæs siden for at opdatere kortet og vise den eksisterende opgave.",mt_warning_team_admin_required:"Kun teamets administrator kan aktivere MeisterTask. Kontakt dem for at anmode om adgang.",must_cut_something_first:"Du skal klippe noget først. ",must_select_destination:"Du skal udpege et mål. ",must_select_something_first:"Du skal vælge noget først.",my_computer:"Min computer",my_folders:"Mine mapper",my_maps:"Mine kort",my_mind_maps:"Mine mind maps",myaccount:"Min konto",mymedia:"Mine medier",myteam:"Mit team",name:"Navn",name_is_already_added:'"%{name}" er allerede tilføjet.',navigate_and_select:"Naviger og vælg",need_assistence:"Hvis du har brug for hjælp, så er vi her for at hjælpe dig!",need_more_users:"Har du brug for flere brugere?",network_error:"Din internetforbindelse er ikke stabil. Vi vil tænde for redigering så snart din forbindelse er stabil. %{v0}Test min forbindelse%{v1}",network_slow:"Din internetforbindelse ser ud til at være langsom. Hjælp os med at forbedre vores service ved at %{v0}indsende diagnostik%{v1}.",new:"Ny",new_child_topic:"Nyt underordnet emne",new_editor_teaser_description:"Du får en super overraskelse: En ny interface, forbedret ydeevne og smukke stilarter og temaer til mindmaps. Den bedste oplevelse med mindmapping blev lige lidt bedre! ",new_editor_teaser_description_v2:"Dine kort bliver snart meget bedre. Begynd at mappe i vores nye redigeringsværktøj for at nyde godt af en ny, elegant brugerflade, forbedret ydeevne, fantastiske funktioner og flotte temaer.",new_folder:"Ny mappe",new_from_template:"Ny fra skabelon",new_group:"Ny gruppe",new_meistertask_project:"Nyt MeisterTask-projekt",new_mind_map:"Nyt mindmap",new_mind_map_beta:"Nyt mindmap (betaversionen)",new_mind_map_legacy:"Nyt mindmap (ældre)",new_notes:"Nye noter",new_presentation:"%{v0} har startet en præsentation",new_presentation_slide:"Nyt præsentations-slide",new_project:"Nyt Projekt",new_project_assign_task:"Du skal bare oprette et nyt projekt og begynde at tildele opgaver til dit team",new_sibling_topic:"Nyt sideordnet emne",new_topics:"Nye punkter",newest_first:"De nyeste først",news_on_s:"Nyt på %{v0}",newsletter_notification_content:"Vær den første til at lære om vores seneste opdateringer, udgivelser af nye funktioner og MindMeister-tips!",next:"Næste",next_payment_on_date:"Næste betaling d. %{date}",njet:"Nej",no_attachments:"Ingen bilag",no_auto_image_was_found:"Intet WunderBild blev fundet til emnet %{v0}",no_auto_note_found_for_topic:"Ingen WunderNote fundet til dette emne",no_auto_video_found_for_topic:"Ingen WunderVideo fundet til dette emne",no_files:"Ingen filer",no_files_found:"Ingen filer fundet",no_icon_selected:"Du skal vælge et ikon først",no_image_selected:"Du skal vælge et billede først",no_image_was_found:"Ingen billeder fundet - prøv fx med et kortere søgeord",no_images:"Ingen billeder",no_keep_it:"Nej, behold",no_link_found_for_topic:"Intet WunderLink fundet til dette emne",no_linked_tasks:{description:"Vælg et emne, og link en opgave til det.",title:"Ingen tilknyttede opgaver endnu."},no_maps:"Det ser ud til at du ikke har nogle maps endnu.",no_maps_found:"Ingen offentlige maps blev fundet",no_matches_found:"Ingen resultater fundet",no_permissions_to_perform_this_action:"Du har ikke rettigheder til at udføre denne handling.",no_projects:"Projekter",no_results_found_with_query:'Ingen resultater fundet med " %{query} "',no_results_received:"Ingen resultater fundet",no_target_node_selected:"Ingen destinationsnode valgt",no_thanks_just_start_first_project:"Nej tak. Start bare mit første projekt ...",no_thanks_just_start_mind_mapping:"Nej tak. Start bare med mindmapping ...",no_topic_selected:"Intet emne valgt",no_video:"Ingen video",no_video_selected:"Du skal vælge en video først",no_video_was_found:"Ingen videoer blev fundet - prøv at afkorte din søgning med fx færre ord",node_copied_unavailable:"Punktet som du kopierede er ikke længere tilgængeligt",node_cut_unavailable:"Punktet du klippede er ikke længere tilgængeligt",node_has_no_image:"Det valgte punkt har intet billede",node_has_no_video:"Det valgte punkt har ingen video",node_search:{empty_search_text:"Vidste du, at du kan søge efter emnetitler, kommentarer og noter.",empty_search_text_v2:"Søg i emner, kommentarer eller noter.",filter:{all_filters:"Alle",comments:"Filtrer kommentarer",node_titles:"Filtrer emnetitler",notes:"Filtrer noter"},no_results_found:'Ingen resultater for "%{query}".'},none:"Ingen",none_is_editing_on_this_map_now:"Ingen andre redigerer dette mindmap",not_assigned:"Ikke tilknyttet",not_due:"Ikke udløbet",not_in_a_team:"Ikke på et team",not_now:"Ikke Nu",not_started:"Ikke påbegyndt",note:"Note",note_is_too_long:"Denne note er for lang",notes:"Noter",notes_promotional_popover:{description:"Nu kan du nemt style og strukturere dine noter, så du får en bedre noteoplevelse.",title:"Brug styles på dine noter"},notes_promotional_popover_toolbar:{description:"Har du brug for mere plads til at dokumentere og strukturere dine ideer? Opret, style og del noter i langt format i MeisterTask.",title:"Opret noter i MeisterTask"},notice:"Bemærk",notice_images_notes_on_last_idea_level_excluded:"Bemærk: Billeder og noter på laveste idéniveau medtages ikke. ",notification:{add_attachment_multiple:"tilføjede %{count} vedhæftninger",add_attachment_single:' tilføjede en vedhæftning til "%{topic}"',add_comment_multiple:"kommenterede på %{count} emner",add_comment_single:'kommenterede på "%{topic}"',add_image_multiple:"tilføjede %{count} billeder",add_image_single:'tilføjede et billede til "%{topic}"',add_vote_multiple:"stemte på %{count} emner",add_vote_single:'stemte på "%{topic}"',down_vote_single:'kunne ikke lide "%{topic}"',edit_image_single:'redigerede et billede på "%{topic}"',icon_multiple:"fuldførte %{count} opgaver",icon_single:'fuldførte "%{topic}" ',insert_multiple:"tilføjede %{count} emner",insert_single:'tilføjede "%{topic}"',note_multiple:"tilføjede %{count} notater",note_single:'tilføjede et nota til "%{topic}"',task_multiple:"tildelte %{count} opgaver",task_single:'tildelte "%{topic}"',title_multiple:"redigerede %{count} emner",title_single:'redigerede "%{topic}"',up_vote_single:'syntes godt om "%{topic}"'},notifications:"Meddelelser",november:"november",november_short:"nov",num_employees:"Antal medarbejdere",num_of_total:"%{num} af %{total}",num_users:"Antal brugere",numbering:"Tilføj numre",numbering_clear:"Fjern nummerering",numbering_heading:"Nummerering",numbering_hint:"Det ser ud til at underpunkterne allerede er nummererede.",numbering_renumber:"Nummerer igen",oauth2:{authorization_with_external_service_required:"Du skal tillade MindMeister at oprette forbindelse."},october:"Oktober",october_short:"okt",ok:"OK",older:"Ældre",older_messages:"Vis tidligere beskeder",oldest_first:"De ældste først",on_your_plan_subscription:"på dit %{plan}-abonnement",onboarding:{basic:{add_sibling_topic:{description:"Godt gået! Nu kan du tilføje et søster-tema ved at trykke %{key}, tilføj dit indhold og tryk %{key} endnu en gang.",title:"Tilføj et Søster-Tema"},add_title:{description:"Først skal du tilføje en titel i midten af dit mindmap som fx produktlancering. Tryk på %{key}, når du er færdig."},add_topic:{description:"Nu skal du tilføje et emne ved at trykke %{v1}. Indtast dit indhold og tryk %{v2} igen når du er færdig."},drag_drop:{description:"Træk og slip blot et emne ind i et andet. Prøv selv!",title:"Træk og Slip"},name:"Kom i gang",welcome:{description:"Her hjælper vi dig med det grundlæggende, så du bliver en mindmap-Jedi på ingen tid! Klar?",title:"Velkommen til MindMeister"}},footer:{export_map:{description:"Konverter dine maps til PDF, Word, PowerPoint og mange andre formater. Klik på skyikonet i det nederste hjørne til højre.",title:"Eksporter dit mindmap"},history_view:{description:"Vores Historikvisning lader dig gennemgå enhver ændring og gå tilbage til gamle versioner af dit mindmap. Prøv det nu!",title:"Historikvisning"},invite_collaborators:{description:"Klik på knappen Del for at se, hvordan du kan invitere andre til dit mindmap, dele et link eller offentliggøre det online.",title:"Inviter andre"},name:"Samarbejde",welcome:{description:"MindMeister vil hjælpe dig med at samarbejde med dit team: Lige fra at dele dit mindmap til eksport af slides fra din præsentation til mødet.",title:"Samarbejde der er nemt"}},meistertask:{finish:{description:"Du er på vej til at blive en Grand Master når det gælder mind mapping. For flere tips og tricks, så se vores %{v1}Mind Meister Akademi%{v2}. Hyg dig med mind mapping!",title:"Godt gået! %{icon}"},name:"Kraftfuld opgavestyring",video_tutorial:{description:"Nu skal du bare følge instruktionerne på skærmen for at komme i gang. Se denne %{v1}videovejledning%{v2} for at få en virtuel gennemgang. ",title:"Få tingene gjort"},welcome:{description:"Brug vores kraftfulde opgavestyrings-app MeisterTask for at konvertere dine ideer til opgaver som skal fuldføres.",title:"Forvandl dine ideer til handling"}},presentation:{create_auto_presentation:{description:"Hvis du ikke gider at svede, gør vi arbejdet for dig. Se selv nedenfor."},name:"Præsentationstilstand",play_presentation:{description:"Lad os kigge lidt på din præsentation. Begynd diasshowet ved at klikke på knappen til højre. "},welcome:{description:"Præsentationstilstand lader dig forvandle dit mindmap til en smuk præsentation på få sekunder. Lad os kigge nærmere!",title:"Byg et Diasshow"}},progress:{description:"Det er nemt at komme i gang med MindMeister. Vi har forberedt fem korte vejledninger, så du kan komme i gang."},remove_warning:"Du er ved at afslutte denne vejledning. Du vil ikke kunne vende tilbage til denne trinvise guide.",share_your_map:"Brainstorm, samarbejd og udvid dine idéer ved at dele dit mindmap!",sidebar:{add_attachment:{description:"Upload PDF-filer, regneark, designs eller andre dokumenter for at sikre at vigtige filer gemmes sammen med dine ideer."},add_image:{description:"Aktiver billedpanelet ved at klikke på det pulserende ikon. Her kan du tilføje billeder fra vores billedgalleri, direkte fra nettet eller uploade dine egne.",title:"Billeder & Videoer"},add_link:{description:"Du kan tilføje links til dine emner for at forbinde dine idéer med en hjemmeside eller omdirigere til andre mindmaps."},create_note:{description:"Notat-funktionen lader dig dele vigtige informationer eller skrive detaljer ned omkring din ide."},name:"Sidebjælken",welcome:{description:"Sidebjælken til højre lader dig ændre skriftstørrelse, baggrundsfarver, tilføje ikoner og meget andet. Lad os komme i gang!",title:"Finpuds dit mindmap!"}},slide_show:{brainstorm:{description:"Mindmapping af idéer kan fremhæve forbindelser og relationer, du ellers ville gå glip af. Ved hjælp af et webbaseret værktøj kan du brainstorme med kolleger i realtid, dele idéer og gemme kortet, så du kan referere tilbage til det senere.",heading:"Brainstorm i fællesskab"},next_level:{description:"Notetagning med et mindmap sikrer, at du aldrig glemmer den centrale idé. Et mindmap viser hierarkier, relationer og forbindelser mellem ideer med dets forgreninger i alle retninger med emner og underemner,",heading:"Tag dine noter et skridt videre"},ready:{description:"Nu ved du, hvad et mindmap er, og hvorfor du skal bruge et. Det næste skridt er at lave dit eget! Brainstorm idéer hurtigt og kreativt, tag noter, planlæg projekter og meget mere.",heading:"Klar til at komme i gang?"},what_is:{description:"Et mindmap er en visuel repræsentation af oplysninger, der er struktureret omkring et centralt emne. Det centrale emne i midten af dit mindmap grener sig ud fra centrum for at give dig et overblik over emnet.",heading:"Hvad er mindmapping?"},why_map:{description:"Et mindmap er et simpelt, men utroligt kraftfuldt værktøj. Dens netstruktur kombineret med både billeder og tekst gør det muligt for din hjerne at fordøje komplekse emner på en lettere måde samt forstå, analysere og huske oplysninger.",heading:"Hvorfor mindmap?"}}},onboarding_popover:{mt_onboarding:{title:"Få et bedre overblik over opgaven"},new_map_info:{description:"Opret et nyt kort fra bunden, eller brug vores færdige skabeloner til at komme direkte i gang med arbejdet.",title:"Opret dit første kort"},presentation_mode:{description:"Brug præsentationstilstand til at dele og præsentere dit Mind Map for dit team.",title:"Præsenter dit kort"}},onboarding_survey:{title:"Velkommen til MindMeister",welcome:"Velkommen, %{firstName}",what:{collaborative_brainstorming:"Fælles brainstorming",document_outline:"Skitsering af dokumenter",organize_information:"Organisere oplysninger",other:"Andre",project_planning:"Projektplanlægning",question:"Hvad ønsker du at gøre med MindMeister?"},where:{business:"Team eller firma",education:"Uddannelse",personal:"Personligt og privat",question:"Hvor har du planer om at bruge %{product}?"},who:{answer:{business:{roles:{administration:"Administration",customer_care:"Kundeservice",engineering:"Udviklingsafdeling",human_resources:"Personaleafdeling",management:"Ledelse",marketing:"Markedsføring",other:"Andre",project_management:"Projektstyring",sales:"Salg"},size:{business_num_1:"Bare mig",business_num_100_plus:"100 plus",business_num_11_30:"11-30",business_num_2_10:"2-10",business_num_31_60:"31-60",business_num_61_100:"61-100"},types:{architecture:"Arkitektur",automotive:"Bilindustrien",banking_financial_services:"Bank- og finansielle tjenesteydelser",chemicals_utilities_energy:"Kemikalier/forsyningsselskaber/energi",construction_real_estate:"Byggeri og fast ejendom",consulting:"Konsulentvirksomhed",education_research:"Uddannelse og forskning",food_beverage_agriculture:"Fødevarer, drikkevarer og landbrug",health_pharma:"Sundhed og farma",hospitality_tourism:"Hoteller. restaurationer og turisme",it_consulting:"IT-rådgivning",law_tax:"Jura og skat",manufacturing:"Produktion",marketing_design:"Marketing og design",media_publishing_entertainment:"Medier, udgivelse og underholdning",ngos_civil_organizations:"NGO'er og civile organisationer",other:"Andre",public_sector_government:"Offentlig sektor, Regering",retail_wholesale_trade:"Detailhandel, engroshandel og handel",software_development_services:"Softwareudvikling og -tjenester",telecommunications:"Telekommunikation",transportation:"Transport"}},education:{roles:{administrator:"Administrator",educator:"Underviser",student:"Studerende"},size:{education_num_1:"Bare mig",education_num_101_200:"101-200",education_num_11_25:"11-25",education_num_200_plus:"200 plus",education_num_26_100:"26-100",education_num_2_10:"2-10"},types:{other_edu:"Anden uddannelsesinstitution",primary_secondary_school:"Grundskole og gymnasium",university_college:"Universitet"}}},question:{business:{roles:"Hvad er din rolle?",size:"Hvor stort er dit team?",types:"Indenfor hvilken type branche?"},education:{roles:"Hvad er din rolle?",size:"Laver du mindmaps med en gruppe?",types:"Hvor arbejder eller studerer du?"}},title:"Lad os skabe den bedste oplevelse for dig."}},onboarding_tour:{step_actions:{description:"Åbn handlingsmenuen for at tilføje kommentarer og noter til dit kort. Tilføj forbindelser, vedhæftede filer og medier for at tilføje mere kontekst til samarbejdspartnere.",title:"Udfyld hullerne"},step_collaboration:{description:"Alle her? Inviter dit team til kortet, så du kan samarbejde og kommunikere om det.",title:"Begynd at samarbejde"},step_modes:{description:"Skift til konturtilstand for at oprette en lineær struktur til dit kort, eller brug præsentationstilstand til at dele og præsentere dit kort for dit team.",title:"Skift nemt tilstande"},step_presentation:{description:"Brug præsentationstilstand til at dele og præsentere dit kort for dit team.",title:"Præsenter dit kort"},step_styling:{description:"Du kan nemt redigere, tilføje stil til dine emner og skabe unikke mindmaps til dit brand og dine vigtigste use cases",title:"Tilpas dit kort "},step_tasks:{description:"Vores forbedrede opgaveintegration giver dig mulighed for at se opgavens forfaldsdatoer og tildelte direkte på dit kort.",title:"Få et bedre opgaveoverblik"},step_welcome:{description:"Dit virtuelle rum til at skabe, organisere og dele information med dit team",primaryButton:"Start tur",title:"Velkommen til dit kort"}},one_child_idea:"Et underpunkt",one_level:"Trin 1",one_more_thing:"En sidste ting",only_users_groups_or_emails_can_be_added:"Det er kun brugere, grupper eller e-mailadresser, der kan tilføjes.",only_you:"Kun dig",oops_something_went_wrong:"Ups, noget gik galt.",opacity:"Gennemsigtighed",open:"Åben",open_all_maps_in_new_editor:{description:"Få en hurtigere mindmapping-oplevelse. Klik på %{button} for at åbne mindmaps med den nye korteditor som standard. Du kan ændre dette senere i menuen for præferencer.",description_v2:"Er du glad for det nye redigeringsprogram? Indstil det som standard for at åbne alle kort med det. Du kan ændre dette senere i dine præferencer.",title:"Åbn Alle kort i den nye editor"},open_focus_mode:"Åbn fokustilstand",open_folder:"Åbn mappe",open_in_new_tab:"Åbn I Ny Fane",open_in_service:"Åbn i %{service}",open_map:"Åbn mindmap",open_presentation:"Åbn præsentationstilstand",open_settings_for:"Indstillinger for %{name}",open_source_page:"Se på kildesiden.",open_task:"Åbn opgave",open_template:"Åbn skabelon",open_theme_settings:"Åbn temaindstillinger",open_with_legacy_editor:"Åbn med Legacy Editor",open_with_new_editor:"Åbn i ny redigeringstilstand",open_with_regular_editor:"Åbn i almindelig redigeringstilstand",or:"eller",or_browse_files:"eller gennemse filer",or_create_new_task:"Eller opret en ny opgave",or_link_existing_task:"Eller tilknyt en eksisterende opgave",or_sign_up_with_your_email_address:"eller <ml-shortcut>tilmeld dig med din email adresse.</ml-shortcut>",orientation:"Papirretning",other_teams:"Andre teams",other_users_editing:" - andre brugere arbejder lige nu i dette mindmap",outline:"Oversigt",overdue:"Forsinket",override:"Overskriv",override_theme:"Tilpasset udseende fundet",override_theme_text:"Udseendet på nogen af dette mind maps punkter er blevet tilpasset i forhold til standardindstillingerne. Vil du beholde de tilpassede indstillinger eller overskrive dem med det nye tema?",overwrite_existing_boundary:"Overskriv et eksisterende ramme-layout",overwrite_existing_style:"Overskriv eksisterende layout",overwrite_existing_theme:"Overskriv eksisterende tema",owns_the_map:"Ejer kortet",page_d_of_d:"Side %{v0} af %{v1}",panda_invite_dialog:{description_1:"Slut dig til over 99 % af brugerne, der allerede nyder hurtigere, jævnere kortlægning og helt nye funktioner med vores seneste korteditor. Med en helt ny MeisterTask-integration, avancerede noter, opdaterede skabelondesigns og forbedrede præsentationer har dine kort aldrig set bedre ud.",description_2:"<ml-bold> Skift til den nyeste editor uden ekstra omkostninger i dag </ml-bold> for at sikre, at du får det bedste ud af MindMeister - bare rolig, alle dine eksisterende kort vil automatisk blive flyttet til den nye editor.",heading:"Lås op for nye funktioner med den seneste korteditor"},partner:"Partner",partner_portal:"Partner Portal",partners:"Partnere",password_good:"God",password_great:"Perfekt",password_ok:"OK",password_very_weak:"Meget svag",password_weak:"Svag",paste:"Sæt ind ",paste_any_link_here:"Indsæt ethvert link her",paste_as_attachment:"Indsæt som bilag",paste_as_image:"Indsæt som billede",paste_dialog:{description:"Du kan altid bruge tastaturgenveje til alle følgende handlinger:",title:"Vil du aktivere kopiering, klip og indsæt?"},paste_formatted_text:"Indsæt formateret tekst her som fx:\n\nMit mindmap oprettet med tekst\n Her er et emne\n Se, her er endnu et, som har\n  Underemne 1\n  Underemne 2",paste_in_mm:"Indsæt i MindMeister",paste_in_mm_description:"Indsættelse i MindMeister er ikke tilgængelig via kontekstmenuen. Du kan bruge tastaturgenveje til alle følgende kommandoer:",paste_style:"Indsæt layout",paste_style_warning:{missing_selection:"Vælg et emne, som du vil indsætte styling i.",missing_target:"Det kopierede emne skal være på dette kort.",multiple_topics_copy:"Flere emner kopieret. Kopier et emne for at indsætte styling.",paste_from_cut:"Styling kan kun anvendes fra kopierede kortemner."},pasted_invalid_content:"Den indsatte indhold er ugyldigt",pasting_in_mm:"Indsættelse i MindMeister",pay_per_12_month:"Betales årligt",pay_per_1_month:"Betales månedligt",pay_per_6_month:"Betales hver 6. måned",paying_now:"Betal Nu",payment_details:"Indtast betalingsoplysninger",paywall:{attachments:{body:"Udvid kort med så mange filer og billeder, som du vil.",limitation:"%{count} af %{maxCount} anvendte vedhæftede filer.",title:"Ubegrænsede vedhæftede filer"},media:{body:"Forbedre dit kort med JPG-, PNG- og GIF-billeder.",title:"Ubegrænsede medier"}},pdf_fit_format:"Tilpas %{xformat}",pending:"Ventende",percent_done:"%{percent} % udført",percent_vat_included:"%{percent}% Moms inkluderet",permission_required:"Tilladelse påkrævet",permission_required_description:"Du skal være medlem af det tilknyttede projekt for at se denne opgave. Vil du anmode om adgang nu?",personal:"Personlig",phone_label:"Telefon",pin:"Pin",pin_to_expand:"Fastgør for at udvide",plain_text:"Simpel tekst",plan_academic:"Edu Campus",plan_basic:"Basis",plan_basic_public:"Offentlig",plan_business:"Erhverv",plan_edu_personal:"Edu Personlig",plan_edu_pro:"Edu Pro",plan_enterprise:"Virksomhed",plan_limit_reached:"Plangrænsen er nået",plan_old_business:"Pro",plan_personal:"Personlig",plan_pro:"Pro",plan_starter:"Starter",play_presentation:"Afspil præsentation",please_click_pulsating_element:"Klik venligst på det pulserende element",please_copy_only_one_topic:"Kopier venligst kun et emne",please_correct_errors_below:"Vi kunne ikke behandle noget af din data. Ret venligst fejlene nedenfor.",please_describe_this_mind_map_in_a_few_words:"Beskriv venligst dette mindmap med få ord",please_note_browser_not_supported_link:"Vær opmærksom på at din browser ikke er understøttet af MindMei
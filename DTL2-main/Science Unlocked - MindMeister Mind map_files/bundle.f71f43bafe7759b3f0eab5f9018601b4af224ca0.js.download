nce:"Apariencia",apply_themes_styles:"Aplica temas y estilos",applying_theme:"Aplicando tema...",applying_theme_with_name:"Aplicando el tema %{theme_name}...",apps:"Apps",april:"Abril",april_short:"Abr",archived:"Archivado",are_you_sure:"¿Está seguro?",are_you_sure_you_want_to_delete_this_style:"¿Estás seguro que deseas eliminar este estilo?",are_you_sure_you_want_to_proceed:"¿Seguro que deseas continuar?",ask_the_community:"Pregunta a la comunidad",assign:"Asignar",assign_to:"Asignar a",assigned_to:"Asignado a",attach:"Adjuntar",attachment:"Archivo adjunto",attachment_plural:{one:"Archivo adjunto",other:"Archivos adjuntos"},attachment_size_exceeded:"El archivo %{v0} excede el tamaño máximo.",attachment_size_exceeded_list:"Los siguientes archivos superan el tamaño máximo de\n %{size}, por lo tanto, no se pudieron cargar:",attachment_tip:"Arrastra y suelta archivos o pega enlaces en los temas.",attachments:"Archivos adjuntos",attachments_limitation:{description:"En el plan Personal no es posible subir más archivos adjuntos a este mapa. Para desbloquear la función de archivos adjuntos ilimitados, cambia al plan Pro.",description_deadline:"En el plan Personal no será posible subir más archivos adjuntos. Para desbloquear la función de archivos adjuntos ilimitados, cambia al plan Pro.",title:"Los archivos adjuntos son limitados",title_deadline:"Pronto se limitarán los archivos adjuntos"},attachments_limitation_dialog:{description:"El <ml-bold>1 de abril</ml-bold>, actualizaremos el límite de archivos adjuntos del plan Personal. Ahora tendrás <ml-bold>hasta dos archivos adjuntos por mapa mental</ml-bold> (máximo 200 MB por archivo adjunto).\nPodrás editar, duplicar y compartir los mapas existentes que tengan más de dos archivos adjuntos, pero ya no podrás añadir archivos adicionales. Los enlaces a archivos adjuntos no cuentan en el límite.\n\nSi necesitas más de dos archivos adjuntos por mapa, nuestro <ml-bold>plan Pro te ofrece archivos adjuntos ilimitados</ml-bold> y mucho más para cubrir tus necesidades más especificas durante la creación de mapas.",title:"Cambios en el límite de archivos adjuntos en tus mapas"},august:"Agosto",august_short:"Ago",auto_align:"Alineación automática",auto_create_presentation:"Creación automática de Presentación",auto_create_presentation_warning:"Esto eliminará tus diapositivas actuales. ¿Seguro que deseas continuar?",auto_layout:"Distribución automática",available_only_for_manual_layout:"Disponible solo en diseño manual",avatar_could_not_be_updated:"No fue posible actualizar tu avatar. Por favor, inténtalo de nuevo más tarde.",back:"Atrás",back_to_all_maps:"Volver a todos los mapas",back_to_my_maps:"Volver a Mis mapas",background:"Fondo",basics:"Conceptos básicos",beta:"Beta",biannual_payment:"Pago semestral",blank_map:"Mapa en blanco",bold:"Negrita",border:"Borde",broadcast_presentation:"Difundir presentación",broadcast_presentation_text:"Otros colaboradores están en línea en este mapa actualmente. ¿Le gustaría difundir la presentación a estos usuarios?",browse_all_public_maps:"Explorar todos los Mapas Públicos",browse_icon_library:"Explorar biblioteca de íconos...",browse_image_library:"Explorar biblioteca...",browse_maps:"Explorar mapas",browse_public_maps_universe:"Explora el universo de mapas públicos",browse_public_maps_universe_v2:"Explorar mapas públicos",browse_videos:"Buscar videos...",browser_deprecation:{description:"Por favor, actualiza tu navegador para aprovechar al máximo nuestra aplicación.",title:"Este navegador seguirá siendo compatible solo hasta el 10 de mayo."},business:"Empresarial",business_purchase:"¿Es una compra empresarial?",button_sending:"Invitando...",by:"por",by_author:"por <ml-shortcut>%{author}</ml-shortcut>",c_to_copy_content_to_clipboard:"-C para copiar el contenido a tu portapapeles",can_edit:"Puede editar",can_not_find_what_you_are_looking_for:"¿No encuentras lo que buscas?",can_view:"Puede ver",cancel:"Cancelar",cancel_invitations_warning:"Las invitaciones no s
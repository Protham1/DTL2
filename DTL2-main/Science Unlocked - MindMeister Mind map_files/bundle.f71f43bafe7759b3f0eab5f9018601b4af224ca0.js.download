ta.",theme:"Tema",theme_colors:"Tema farver",theme_name_error:"Ugyldigt navn. Skriv venligst kun bogstaver.",theme_options:"Temaindstillinger",theme_override_warning:"Hvis du ændrer korttemaet, tilsidesættes alle brugerdefinerede stilarter, du har anvendt.",theme_will_be_default:"Benyt som standard",theme_will_not_be_default:"Benyt ikke som standard",themes:"Temaer",there_are_no_revisions_for_this_map_it_was_not_modified_yet:"Der er ingen revisioner af dette mindmap. Mindmappet har sandsynligvis ikke været ændret endnu.",there_are_no_suggestions:"Der er ingen forslag. Forsøg venligst med et andet søgeord. ",this_email_already_associated_with_other_product:"Du kan bruge din eksisterende MindMeister-konto til at oprette forbindelse til MeisterTask.",this_image_may_be_subject_to_copyright:"Dette billede er muligvis beskyttet af copyright",this_map_cant_be_initialized:"Dette mindmap kan ikke initialiseres",this_map_is_view_only:"Dette kort er kun til visning.",this_map_is_visible_on_the_internet:"Dette kort er synligt på internettet.",this_site_is_protected_by_recaptcha:"Dette websted er beskyttet af reCAPTCHA, og Googles <ml-privacy> Privatlivspolitik </ml-privacy> og <ml-terms> Servicevilkår </ml-terms> gælder.",thursday:"Torsdag",thursday_short:"tors",title:"Titel",title_and_contents:"Titel & Indhold",title_length_limit_warning:"Opgavetitler kan kun have 255 tegn. Tilføj længere \noplysninger som en beskrivelse i stedet.",title_length_warning:"Grænse på titellængde overskredet",to_add_a_child_idea:"for at tilføje et underemne",to_add_a_sibling_idea:"for at tilføje en sideidé",to_copy:"kopiere",to_create_child:"for at oprette et underemne",to_create_meister_ai_child:"for at oprette <ml-shortcut> Meister AI </ml-shortcut> underordnet",to_create_sibling:"for at oprette sideordnet emne",to_create_topics:"for at oprette emner",to_cut:"klippe",to_get_unlimited_maps_and_more:"for at få ubegrænsede mindmaps, vedhæfte filer og billeder samt eksportere til PDF-filer og mere.",to_indent_topics:"for at rykke emner ind.",to_outdent_topics:"for at rykke emner ud.",to_paste:"indsætte",to_paste_style:"for at indsætte stil",today:"I dag",toggle_sidebar:"Sidebar",toolbar_topic:{text_style:"Tekststil",topic_style:"Emnestil"},tools:"Værktøjer",top_templates:"Foretrukne Skabeloner",topic:"Emne",topic_was_converted:"Emnet blev konverteret til et <maplink> nyt kort </maplink>",topics:"Emner",transition:"Overgang",translate:"Oversæt",transparent:"Gennemsigtig",trash:"Papirkurv",trash_dialog:{upgrade_content:"Gendan dine slettede kort fra skraldespanden.",upgrade_header:"Lås op Gendan kort",you_are_about_to_trash_maps:{one:"Du er ved at smide %{mapName} papirkurven. Du vil ikke kunne fortryde. Vil du slette?",other:"Du er ved at smide %{mapNames} i papirkurven. Du vil ikke kunne fortryde. Vil du slette?"},you_are_about_to_trash_maps_v2:"Du er ved at smide %{mapNames} i papirkurven. Du vil ikke kunne fortryde. Vil du slette?"},trash_items:"Slet genstande",trashcan_premium_feature_warning:"Gendannelse af mind maps fra papirskurven er ikke tilgængeligt i din plan.",trashcan_warning:"Er du sikker på at du vil tømme papirkurven? Denne handling kan ikke fortrydes og de mind maps der ligger i papirkurven nu vil være mistet for altid. ",trashed:"Smidt i papirkurven",trashed_maps:"Slettede mindmaps",try_again:"Prøv igen",try_another_name_or_suggest_template_to_our_team:"Prøv et andet navn, eller foreslå en skabelon til vores team <ml-link> her </ml-link>",try_it:"Prøv det",try_it_now:"Prøv det nu",try_meister_bundle:"Prøv Meister Bundle",try_our_new_editor:"Prøv vores nye redigeringstilstand",try_product:"Prøv %{product}",tuesday:"Tirsdag",tuesday_short:"tirs",turn_mindmaps_to_projects:"Gør dit mindmap til to-dos og projekter",tutorial_description:"Det er nemt at komme i gang med MindMeister. Vi har udarbejdet en kort vejledning for dig at få dig i gang.",tutorial_hint:"Du kan altid genopfriske dine evner inden for mind mapping med dennee vejledning.",tutorial_last_slide_description:"Du har styr på det grundlæggende. Nu kan du udforske flere funktioner eller gå ind og begynde at oprette smukke kort.",tutorial_section:{action_items:{attach:{description:'Tilføj vedhæftede filer til alle emner i dit midnmap. Åbn stylingmenuen, og klik på "Vedhæftning", og indsæt derefter et link eller upload en fil.',header:"Tilføj links eller vedhæftede filer"},comment:{description:'Brug kommentarer til at kommunikere med andre. Klik på "Kommentar" i stylingmenuen, og tilføj derefter tekst eller emojis. Tryk på Enter, når du er færdig.',header:"Sig det med en kommentar"},export:{description:"Eksportér dit mindmap til et filformat, der kan deles: Vælg en PDF-, PowerPoint-, Word- eller billedfil, eller vælg et andet format til dit mindmap.",header:"Der er tid til at eksportere dit kort"},media:{description:'Gør dit mindmap endnu flottere med billeder fra dit lokale drev. Vælg "Medier" i stylingmenuen, og vælg et billede, du vil uploade.',header:"Upload dine egne billeder"},note:{description:'Brug noter til at uddybe et emne uden at fylde mindmappet ud. Hvis du vil tilføje en note til et emne, skal du vælge "Note" i stylingmenuen.',header:"Giv en kontekst med en note"}},basics:{collaborate:{description:"Samarbejd i realtid. Inviter kolleger til at samarbejde, brainstorme og kommentere på dit mindmap.",header:"Gør dit kort muligt at samarbejde i"},navigate:{description:"Naviger hurtigt rundt i kortemnerne ved hjælp af piletasterne på tastaturet.",header:"Navigere med tastaturet"},style:{description:"Klik på ikonet med malerpenslen i menuen for at skifte udseendet på et emne. Du kan tilpasse formatering af linje-, emne- og skrifttype.",header:"Gør dit kort stilfuldt"},theme:{description:"Gør dit kort iøjnefaldende med MindMeisters foruddefinerede temaer. Vælg mellem en række attraktive designs i lys og mørk tilstand.",header:"Et tema for hvert team"},topic:{description:"Alle mindmaps starter med en hovedidé. Dobbeltklik på hovedemnet for at redigere, og brug derefter Enter og Tab for at tilføje underemner.",header:"Tilføj emner og underemner"}},key_features:{connections:{description:"Tegn linjer mellem forbundne idéer og emner. Bestem stilen på linjen, og skift dens placering.",header:"Opret forbindelser på dit kort"},layout:{description:"Du kan vælge mellem tre forskellige layouts: Du kan se dine idéer som et mindmap, et organisationsdiagram eller en liste.",header:"Et layout til hvert emne"},outline:{description:"Lav dit mindmap om til en oversigt i punktopstilling. Klik på menuen i nederste venstre hjørne for at skifte mellem de to visninger.",header:"Introduktion til oversigtstilstand"},presentation:{description:"MindMeister definerer diasrækkefølgen automatisk, men du kan klikke på et emne for at springe til det under præsentationen.",header:"Præsentation"},search:{description:"Brug søgning til at finde indhold i emnetitler, kommentarer og noter. Hvis det er på dit kort, kan du hurtigt finde et hvilket som helst ord eller udtryk.",header:"Spar tid med Søgning"},versions:{description:'Klik på "Versioner" for at få vist tidligere ændringer i dit mindmap. Du kan nemt lave en kopi eller gendanne en tidligere version af mindmappet.',header:"Se ændringer, der er foretaget på dit kort"}},presentation:{details:{description:"Du kan sammenklappe og udvide emnerne i dit mindmap for at gøre din præsentation så detaljeret, som den skal være.",header:"Det hele ligger i detaljerne"},navigation:{description:"MindMeister definerer diasrækkefølgen for dig. Naviger i præsentationer ved at klikke på Emner eller panorere rundt på kortet.",header:"Er alt på plads?"},present:{description:"Har du en idé, der er værd at dele? Brug <ml-shortcut>%{modifier}</ml-shortcut> for at vise dit Mind Map som en præsentation.",header:"Præsenter dit mindmap"},starting_point:{description:"Præsentationer begynder med det valgte emne. Hvis du forlader en præsentation, kan du nemt fortsætte, hvor du slap.",header:"Start showet"}},styling:{emoji:{description:"Med emoji-menuen kan du lettere udtrykke dig selv og dine ideer . Du skal blot skrive et : (kolon) og vælge fra emoji-menuen.",header:"Udtryk dig selv med emojis"},icon:{description:"Giv dit mindmap liv med klarggjorte ikoner og billeder. Klik på et ikon for at redigere eller ændre størrelsen.",header:"Et billede siger mere end 1000 ord"},layout:{description:"Brug automatisk layout til hurtigt at organisere dit mindmap. Deaktiver det automatiske layout for manuelt at trække og slippe emner til overalt på lærredet.",header:"Placer emner let"},text:{description:"Brug skrifttypemenuen til at justere tekststørrelse, -farve og -typografi. Tiltræk opmærksom til store ideer!",header:"Tekst skabt til at skille sig ud"},theme:{description:"Smart Tint vælger den bedste farve til dit korts tema. Brug den til at vælge farver til emnetypografi, ikontoner eller stregfarver.",header:"Smukt designede emner"},topic:{description:"Brug stylingmenuen til at ændre emneform, udfyldning og streg. Du kan også justere stregfarve, -vægt og -stil.",header:"Kortstyling til ethvert emne"}},team_work:{collaborate:{description:"Samarbejd med et ubegrænset antal mennesker i realtid. Du kan se, hvem der arbejder på kortet og kommentere emner.",header:"Mindmap sammen"},invite:{description:"Del dit mindmap med andre brugere via en invitationsmail eller et link, der kan deles.",header:"Del dit kort med andre"},mt:{description:'Omdan ethvert emne til en opgave, der kan gennemføres i MeisterTask. Klik på ikonet "Tildel", og følg derefter trinene for at gennemføre handlingen.',header:"Omdan dine ideer til opgaver"}}},tutorials:"Vejledninger",two_levels:"To trin",type_of_institution:"Institutionstype",unable_to_withdraw_from_the_following_maps_s_because_of_group_share:"Kan ikke fjernes fra %{v0} pga. gruppedeling.",unassigned:"Ikke tildelt",undelete:"Fortryd slet",undo:"Annuller",undo_in_collaboration_mode:"Hvis du vil fortryde bedes du forlade brainstorming-tilstand. Brainstorming er aktiv, når der er mere end én bruger på kortet.",undo_last_change:"Annuller sidste handling %{v0}",unfollow:"Følg ikke",unknown_video:"Ukendt video",unlimited:"Ubegrænset",unpin:"Frigør",unpublish:"Fjern fra universet",unpublish_map:"Annuller offentliggørelse af kort",unshare_map:"Annuller deling af mindmap",unshare_map_warning:"Hvis du gør dette mindmap privat, fjernes alle medarbejdere. Er du sikker på, du vil fortsætte?",unsupported_file_type:"Ikke understøttet filtype",update_failed:"Opdatering mislykkedes",update_failed_description:"Der opstod en fejl under opdateringen. Prøv venligst igen.",updated_upper:"OPDATERET",upgrade:"Opgrader",upgrade_for_unlimited_maps:"Opgrader for ubegrænsede kort.",upgrade_nagger:{basic:{description:"Nyd ubegrænset plads til dine ideer, tidsbesparende funktioner og meget mere.",title:"Lås op for uendelige muligheder"},personal:{description:"Planlæg, brainstorm og samarbejd nemt med dit team. ",title:"Visualiser ideer – sammen"},pro:{description:"Med robuste sikkerheds- og teamstyringsfunktioner.",title:"Samarbejd i skala"}},upgrade_now:"Opgrader nu",upgrade_now_button:"Opgrader nu",upgrade_to:"Opgrader til",upgrade_to_plan:"Opgrader til %{plan}",upgrade_to_plan_also_gives_you:"Ved at vælge %{plan} får du også:",upload:"Upload",upload_a_file:"Upload en fil",upload_failed:"Upload mislykkedes",upload_file:"Upload fil",upload_image:"Upload billede",upload_media:"Upload medier",upload_new_image:"Upload nyt billede...",upload_s_files_available:"Upload %{count}/%{maxCount} tilgængelige filer",upload_unlimited_files:"Upload ubegrænsede filer",upload_unlimited_media:"Upload ubegrænset medier",uploading:"Uploader...",uploading_s_files:{one:"Uploader 1 fil",other:"Uploader %{count} filer"},uploading_s_percent:"Uploader %{percent}%",url:"URL",url_not_valid:"URL ikke gyldig",use:"Anvend",use_an_image_from_the_web:"Billede fra web...",use_mindmeister_with_meistertask:"Brug MindMeister med MeisterTask",use_outline_mode:"Brug Outline-tilstand",use_template:"Anvend skabelon",used_colors:"Anvendte farver",user:"Bruger",user_count:{one:"1 bruger",other:"%{count} brugere"},user_count_with_discount:"%{count} brugere - %{discount} rabat",user_disabled:"Bruger deaktiveret",user_interface:"Brugerinterface",user_is_already_added:'Brugeren "%{name}" er allerede tilføjet.',user_preferences:{always_use_new_editor:"Brug altid den nye redigeringstilstand",expand_links:"Udvid automatisk links",image_searcher:"Søg efter billeder via",language_and_region:"Tid og Sprog",open_map_editor_target:"Åbn maps i ny browser tab",topic_link_preview:"Indsæt automatisk eksempler på billeder til links",video_searcher:"Søg efter videoer med"},user_sent_msg:"%{v0} sendte dig en ny besked",users:"Brugere",users_subscription_change:"Skift",valid_until:"Gyldig indtil",vat_id:"CVR-NR.",version_history:"Versionshistorik",versions:"Versioner",view_changes_on_this_idea:"Se ændringer...",view_only:"Kun visning",viewer:"Seer",views_d:{one:"1 visning",other:"%{count} visninger"},visit_url:"Besøg URL",volume_discount:"Mængderabat",vote:"stemme",voted:"%{v0} stemte",votes:"stemmer",want_to_be_able_to_restore_trashed_maps:"Vil du gerne kunne gendanne slettede mindmaps?",want_to_get_more_out_of_product:"Vil du få en hurtig introduktion til, hvordan du får mest ud af, hvad %{product} har at tilbyde?",warning:"Advarsel",warning_may_take_minutes_connect:"ADVARSEL: Dette vil synkronisere alle dine mindmaps til Google Drive og kan tage et par minutter",warning_may_take_minutes_disconnect:"Advarsel: Dette afbryder alle dine maps fra Google Drive og kan tage et par minutter",we_are_sorry_request_was_not_done:"Vi beklager, men din anmodning blev ikke gennemført denne gang. En fejl opstod. Prøv igen.",we_will_use_info_for_product:"Vi bruger denne information til at hjælpe dig med at få mest muligt ud af %{product}.",webcam_error_message:"Dit webcam er ikke tilgængeligt. Undersøg venligst om dit webcam allerede kan være i brug eller dine browserindstillinger.",wednesday:"Onsdag",wednesday_short:"ons",welcome:"Velkommen",welcome_by_name:"Hej %{name}, velkommen til Mindmeister!",welcome_dialog:{confirm_button:"Sæt i gang!",content:"Velkommen til det helt nye MindMeister. Din nye editor ser bedre ud, føles bedre og hjælper dig med at skabe episke online mindmaps. Dine maps åbnes nu i den nye editor ... så lad os se, hvad den nye MindMeister kan!",create_promo_map:{error_button_label:"Ok",error_description:"Midlertidige problemer med MindMeister kan normalt løses ved at genindlæse.",error_title:"Kortet blev ikke indlæst"},secondary_button:"Få mere at vide",title:"En ny verden, kortlagt."},welcome_dialog_description:"til din spritnye oversigt over maps",welcome_dialog_quote:"Vi har haft travlt med at tilpasse og finpudse din liste med mindmaps. Og jeg må indrømme, at dine mindmaps ser specielt flotte ud i dag. Glædelig mindmapping!",welcome_name:"Velkommen %{name} !",welcome_to_the_new_editor:"Velkommen til den nye redigeringstilstand!",welcome_to_the_new_editor_description:"Vi præsenterer vores nye interface med forbedret ydeevne, funktioner og smukke stile og temaer til mindmaps. Bliv vist rundt i MindMeisters helt nye design, og kom i gang med mindmapping! ",welcome_what_kind_of:"Hvilken %{type} er det?",what_about_you:"Hvad med dig?",what_is_new:"Hvad er nyt?",what_is_new_teaser_description:"Velkommen til en mere intuitiv måde for mindmaps. Tag en rundvisning i MindMeister med helt nyt design, og kom i gang med mindmapping!",what_to_do:"Hvad vil du gøre? ",when_you_upgrade_you_also_get:"Når du opgraderer, får du også:",width:"Bredde",with_your_basic_plan_you_can_only_edit_mind_maps_s:"Med dit Basic-abonnement kan du kun redigere de %{count} nyeste kort i din liste.",work:"Arbejde",write_a_personal_message:"Skriv en personlig besked",year:"år",yes_remove:"Ja, fjern",yesterday:"I går",you:"Du",you_are_about_to_delete:"Du er ved at slette",you_are_about_to_delete_items_s:"Du er ved at slettet følgende emne: %{v0}",you_are_about_to_trash:"Du er ved at slette",you_are_about_to_trash_items_s:"Du er i gang med at slette følgende genstande: %{v0}",you_are_about_to_withdraw:"Du er ved at forlade",you_are_in_view_only_mode:"Du er i 'vis kun'-tilstand",you_are_missing_out:"Du går glip af noget!",you_can_only_view_this_map:"Du kan kun se dette kort.",you_can_undo_afterwards:"Du kan fortryde alle ændringer bagefter. ",you_cannot_add_yourself:"Du kan ikke tilføje dig selv!",you_cannot_use_undo_redo_in_collaborative_mode:"Stop brainstorming-tilstand ved at bede andre brugere om at forlade dette mindmap, så du sikkert kan fortryde ændringer.",you_cant_do_things_become_premium_to_do_that_s:"<em>Beklager, %{v0} er kun for betalende medlemmer</em> Opgrader din konto til %{v1}.",you_have_run_out_of_maps:"Du har løbet tør for maps.",you_like_this:"Du foretrækker dette",you_still_have_tasks_sure_want_to_withdraw:"Du har stadig opgaver tilknyttet dig i dette mindmap. Er du sikker på, du vil forlade det?",you_will_get_unlimited_maps_in_all_paid_plans:"Du får ubegrænsede kort i alle de betalte abonnementer.",your_browser_does_not_support_this_feature:"Din nuværende browser understøtter ikke denne funktion.",your_browser_is_not_able_to_display_frames_html:"Din browser kan ikke vise rammer. Besøg venligst %{link} på MindMeister.",your_free_mind_meister_plan_supports_mind_maps_s:"Din gratis MindMeister plan understøtter op til %{v0} mind maps. ",your_message:"Din Besked",your_request_was_not_done:"Forespørgsel mislykkedes",your_role:"Din rolle",your_team_managed:"Dit team, administreret.",your_turn:"Det er din tur!",z_to_a:"Å til A",zip_code:"POSTNUMMER",zoom_in:"Zoom ind",zoom_level:"Zoomniveau",zoom_out:"Zoom ud"},text:"Tekst"}}},function(t,o){t.exports={de:{js:{a_to_z:"A bis Z",about:"ungefähr",about_thumbshot_thumbails:"Über Thumbshots-Vorschaubilder",access_request_sent:"Zugriffsanfrage gesendet",access_request_sent_description:"Sie werden per E-Mail benachrichtigt, wenn Ihre Anfrage zur Teilnahme am Projekt ang